# User Service local configuration template
# Copy this file to .env and fill it with private values.

SERVER_PORT=8081

# Local database connection
DB_URL=jdbc:postgresql://localhost:5432/user_service
DB_USERNAME=user_service
DB_PASSWORD=user_service

# JPA strategy for local development
JPA_DDL_AUTO=update

# Shared secret for JWT validation/issuance in later HU-08 work
JWT_SECRET=change-me-in-local-env
JWT_EXPIRATION_SECONDS=86400

# Optional CORS configuration for later integration work
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081