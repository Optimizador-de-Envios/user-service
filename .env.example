# User Service docker/testing configuration template
# Copy this file to .env and fill it with private values.

SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/user_service
DB_USERNAME=user_service
DB_PASSWORD=user_service

# JPA
JPA_DDL_AUTO=update

# Shared secret for JWT validation/issuance
JWT_SECRET=change-me-in-env
JWT_EXPIRATION_SECONDS=86400

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://frontend:80
